import Ed1000 from '../components/Ed1000.astro';
import Sikayetler from '../components/Sikayetler.astro';
import ErkenTani from '../components/ErkenTani.astro';
import DrBudak from '../components/DrBudak.astro';
import Muayene from '../components/Muayene.astro';
