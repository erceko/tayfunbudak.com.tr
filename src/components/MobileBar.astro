---
// Phones and small tablets only (≤ 900 px). Hidden while the hero buttons or the appointment form are on screen.
const WA = 'https://wa.me/905306619000?text=Merhaba%2C%20randevu%20almak%20istiyorum.';
---
<nav class="mb-bar" aria-label="Hızlı iletişim" aria-hidden="true" inert>
  <a class="mb-b" href="tel:+902122912222">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ac1f2d" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3.5l1.8 4.4-2.3 1.4a11 11 0 0 0 6.2 6.2l1.4-2.3L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"></path></svg>
    <span>Ara</span>
  </a>
  <a class="mb-b" href={WA}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#13854a" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.7-5.2A8.5 8.5 0 1 1 21 12z"></path><path d="M9 9.5c.3 1.8 1.7 3.6 3.6 4.6l1-1 1.9.8"></path></svg>
    <span>WhatsApp</span>
  </a>
  <a class="mb-b mb-pr" href="#randevu">
    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
    <span>Randevu Al</span>
  </a>
</nav>

<style is:global>
.mb-bar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:none;grid-template-columns:1fr 1fr 2fr;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:#ffffff;border-top:1px solid #e7e3f2;box-shadow:0 -10px 30px rgba(32,20,68,.16);transform:translateY(110%);transition:transform .22s ease}
.mb-bar.is-on{transform:none}
.mb-b{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:52px;border-radius:12px;background:#f1edfb;color:#201444;font-size:12.5px;font-weight:700;line-height:1.1;text-decoration:none}
.mb-b:hover{color:#201444}
.mb-pr{flex-direction:row;gap:10px;background:#ac1f2d;color:#ffffff;font-size:16.5px}
.mb-pr:hover{color:#ffffff;background:#8e1825}
.mb-b:focus-visible{outline:2px solid #201444;outline-offset:2px}
@media (max-width: 900px){.mb-bar{display:grid}body{padding-bottom:calc(76px + env(safe-area-inset-bottom))}}
@media (prefers-reduced-motion: reduce){.mb-bar{transition:none}}
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.mb-bar');
  const targets = [document.querySelector('.v9-ctaw'), document.querySelector('#randevu form')].filter(Boolean) as Element[];
  if (bar && 'IntersectionObserver' in window) {
    const mq = window.matchMedia('(max-width: 900px)');
    const visible = new Set<Element>();
    let ready = false;
    const update = () => {
      const show = ready && mq.matches && visible.size === 0;
      bar.classList.toggle('is-on', show);
      bar.inert = !show;
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
      ready = true;
      update();
    });
    targets.forEach((t) => io.observe(t));
    mq.addEventListener('change', update);
  }
</script>
