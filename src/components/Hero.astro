<script is:inline>
(function () {
  function parallax(el) {
    var w = el.ownerDocument.defaultView || window;
    var mq = function (q) { return !!(w.matchMedia && w.matchMedia(q).matches); };
    if (mq('(prefers-reduced-motion: reduce)')) return function () {};
    var fine = mq('(hover: hover) and (pointer: fine)');
    var tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    var frame = function () {
      raf = 0;
      cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08;
      var r = el.getBoundingClientRect();
      var sy = Math.max(0, Math.min(r.height, -r.top));
      el.style.setProperty('--mx', cx.toFixed(4));
      el.style.setProperty('--my', cy.toFixed(4));
      el.style.setProperty('--sy', sy.toFixed(1));
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = w.requestAnimationFrame(frame);
    };
    var kick = function () { if (!raf) raf = w.requestAnimationFrame(frame); };
    var move = function (e) {
      var r = el.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, (e.clientX - r.left - r.width / 2) / (r.width / 2)));
      ty = Math.max(-1, Math.min(1, (e.clientY - r.top - r.height / 2) / (r.height / 2)));
      kick();
    };
    var leave = function () { tx = 0; ty = 0; kick(); };
    if (fine) { el.addEventListener('pointermove', move); el.addEventListener('pointerleave', leave); }
    w.addEventListener('scroll', kick, { passive: true });
    kick();
    return function () {
      if (raf) w.cancelAnimationFrame(raf);
      el.removeEventListener('pointermove', move);
      el.removeEventListener('pointerleave', leave);
      w.removeEventListener('scroll', kick);
    };
  }
  var el = document.querySelector(".v9-hero");
  if (el) parallax(el);
})();
</script>
